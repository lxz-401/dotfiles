{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/sticker.webp",
    "padding": {
      "right": 5
    },
    "color": {
      "1": "red",
      "2": "white"
    }
  },
  "display": {
    "separator": " ",
    "key": {
      "width": 20,
      "type": "string"
    },
    "color": {
      "keys": "red",
      "title": "white",
      "output": "white"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "outputColor": "white"
    },
    {
      "type": "custom",
      "format": "────────────────────────────────────",
      "outputColor": "red"
    },
    {
      "type": "os",
      "key": "OS",
      "format": "{pretty-name} {arch}"
    },
    {
      "type": "host",
      "key": "HOST"
    },
    {
      "type": "kernel",
      "key": "KERNEL",
      "format": "{sysname} {release}"
    },
    {
      "type": "uptime",
      "key": "UPTIME"
    },
    {
      "type": "packages",
      "key": "PACKAGES"
    },
    {
      "type": "shell",
      "key": "SHELL"
    },
    {
      "type": "terminal",
      "key": "TERM"
    },
    {
      "type": "terminalfont",
      "key": "FONT"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "format": "{name}",
      "condition": {
        "succeeded": true
      }
    },
    {
      "type": "memory",
      "key": "MEMORY",
      "percent": {
        "type": [
          "num",
          "num-color"
        ]
      }
    },
    {
      "type": "swap",
      "key": "SWAP"
    },
    {
      "type": "disk",
      "key": "DISK",
      "folders": "/",
      "format": "{1} / {2} ({3})"
    }
  ]
}
